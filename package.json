{
  "name": "create-tauri-monorepo",
  "version": "0.1.0",
  "description": "Create a Tauri 2 and React monorepo with shared desktop and web UI.",
  "repository": { "type": "git", "url": "git+https://github.com/Jax-Lifu/Tauri2MonoRepo.git" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=22.12.0" },
  "bin": { "create-tauri-monorepo": "scripts/create-app.mjs" },
  "files": [
    ".github", ".gitignore", ".node-version", "app-icon.svg",
    "apps/desktop/components.json", "apps/desktop/index.html", "apps/desktop/package.json",
    "apps/desktop/public", "apps/desktop/src", "apps/desktop/tsconfig.json", "apps/desktop/vite.config.ts",
    "apps/desktop/src-tauri/Cargo.toml", "apps/desktop/src-tauri/build.rs", "apps/desktop/src-tauri/tauri.conf.json",
    "apps/desktop/src-tauri/capabilities", "apps/desktop/src-tauri/icons", "apps/desktop/src-tauri/src",
    "apps/web/components.json", "apps/web/index.html", "apps/web/package.json",
    "apps/web/public", "apps/web/src", "apps/web/tsconfig.json", "apps/web/vite.config.ts",
    "crates/core/Cargo.toml", "crates/core/src",
    "packages/i18n/package.json", "packages/i18n/tsconfig.json", "packages/i18n/src",
    "packages/shared/package.json", "packages/shared/tsconfig.json", "packages/shared/src",
    "packages/tsconfig/package.json", "packages/tsconfig/base.json",
    "packages/ui/package.json", "packages/ui/tsconfig.json", "packages/ui/components.json",
    "packages/ui/LICENSE.shadcn", "packages/ui/src", "Cargo.toml", "Cargo.lock",
    "pnpm-lock.yaml", "pnpm-workspace.yaml", "rust-toolchain.toml",
    "turbo.json", "vitest.config.ts", "scripts/create-app.mjs"
  ],
  "scripts": {
    "dev:web": "pnpm --filter @app/web dev",
    "dev:desktop": "pnpm --filter @app/desktop tauri dev",
    "ui:add": "shadcn add --cwd apps/web",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@app/web",
    "build:desktop": "pnpm --filter @app/desktop tauri build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:rust": "cargo test --workspace --locked",
    "check": "pnpm typecheck && pnpm test && cargo fmt --all --check && cargo clippy --workspace --all-targets --locked -- -D warnings"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^26.0.0",
    "shadcn": "4.22.1",
    "turbo": "^2.5.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  }
}
